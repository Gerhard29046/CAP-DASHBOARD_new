# Environment files containing private settings
.env
.env.*
!.env.example
!**/.env.example
!frontend/.env.production

# Dependencies
backend/vendor/
frontend/node_modules/
node_modules

# Firebase local emulator artifacts (Android's firestore/storage rules only -- Cloud
# Functions were retired 2026-08-13, see docs/ai-memory/DECISIONS.md; workers/ uses the
# generic Wrangler cache rule below instead)
.firebase/
firebase-export-*/

# Build output
frontend/dist/
dist
dist-ssr
mobile-android/.gradle/
mobile-android/build/
mobile-android/app/build/

# Android local machine configuration and signing material
mobile-android/local.properties
*.jks
*.keystore
**/service-account*.json
**/*firebase-admin*.json
**/client_secret*.json

# Logs
*.log
/logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Vite
.vite

# Wrangler local cache
.wrangler/
frontend/.wrangler/

# IDE and editor directories
.vscode/*
!.vscode/extensions.json
.idea
*.suo
*.njsproj
*.sln
*.sw?

# OS
.DS_Store
*.local

# Private source documents
reference-docs/

# Ruflo / Claude Flow MCP local runtime state (generated, machine-specific)
.claude-flow/
.swarm/
ruvector.db
.claude/.proven-config-version
.claude/helpers/.helpers-version
