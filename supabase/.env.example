# Copy to supabase/.env (gitignored, never commit real values here or in that file).
# Used by scripts/migrate-firestore-to-postgres.mjs and scripts/smoke-test.mjs.

SUPABASE_URL=
# Publishable/anon key -- safe to expose client-side, constrained by RLS.
SUPABASE_ANON_KEY=
# service_role key -- bypasses RLS entirely. Server-side/local-tooling only. Required for
# migrate-firestore-to-postgres.mjs's --apply mode and for smoke-test.mjs's automatic test-
# user creation/cleanup; without it, smoke-test.mjs falls back to a slower, less-clean path.
SUPABASE_SERVICE_ROLE_KEY=

# Only needed by migrate-firestore-to-postgres.mjs (the Firestore data migration, not yet
# executed). Defaults shown match the current Firebase project/database.
# FIREBASE_PROJECT_ID=capdatabasefb2
# FIRESTORE_DATABASE_ID=capdashboard
# FIREBASE_STORAGE_BUCKET=capdatabasefb2.firebasestorage.app
