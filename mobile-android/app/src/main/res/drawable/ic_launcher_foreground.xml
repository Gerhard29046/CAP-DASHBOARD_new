<?xml version="1.0" encoding="utf-8"?>
<!--
    Adaptive-icon foreground layer: a bold geometric "C" monogram (CAP / Connoisseur) in
    CapPrimaryForeground white on the blue background layer.

    Geometry, so it stays editable without guesswork: a ring centred on (56.5, 54) with outer
    radius 27 and inner radius 16.5 (10.5 stroke weight), opened on the right by a 70 degree
    wedge with flat radial terminals at +/-35 degrees. The centre is nudged 2.5 right of the
    viewport centre so the C's own asymmetric mass lands optically centred.

    That puts every painted pixel inside x 29.5..78.6, y 27..81, within the ~66dp centre
    region the OS guarantees is visible after circle/squircle/teardrop masking.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M78.617,38.513 A27,27 0 1 0 78.617,69.487 L70.016,63.464 A16.5,16.5 0 1 1 70.016,44.536 Z" />
</vector>
