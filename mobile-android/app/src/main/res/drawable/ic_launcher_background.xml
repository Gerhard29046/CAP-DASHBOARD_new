<?xml version="1.0" encoding="utf-8"?>
<!--
    Adaptive-icon background layer. Flat CapPrimary (#2584F8) from ui/theme/Color.kt, which is
    the same accent the web app and every in-app CAP surface uses. Deliberately a solid fill
    rather than a gradient: the OS crops this layer to an unpredictable mask shape, so any
    gradient direction would land differently on different launchers.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <path
        android:fillColor="#2584F8"
        android:pathData="M0,0h108v108h-108z" />
</vector>
